      </al>
      <tr xml:lang="en">
        Isis-the-Great   
      </tr>
    </text>
    <text id="text4">
      <desc>Viewer-left side of pedestal</desc>
      <himg src="${assets}/yasmin/texts/text_4.svg" dest="img/yasmin_text4.svg"/>
      <al encoding="mdc">
